{
  "name": "tashevos",
  "version": "0.1.0-alpha.1",
  "description": "The open control plane for AI coding.",
  "type": "module",
  "bin": {
    "tash": "dist/cli.js",
    "tashevos": "dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE", "docs/assets"],
  "scripts": {
    "dev": "npm run build && node dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run check"
  },
  "engines": { "node": ">=20" },
  "keywords": ["ai","coding-agents","agent-memory","context-engineering","mcp","claude","codex","cursor","gemini"],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
